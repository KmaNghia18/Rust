# ─── Auth Service ──────────────────────────────────────────────
AUTH_SERVICE_PORT=8001
DATABASE_URL=postgres://postgres:password@localhost:5432/discord_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Gateway Service ───────────────────────────────────────────
GATEWAY_PORT=8000
GATEWAY_REDIS_URL=redis://localhost:6379

# ─── Guilds Service ────────────────────────────────────────────
GUILDS_SERVICE_PORT=8002
GUILDS_DATABASE_URL=postgres://postgres:password@localhost:5432/discord_dev

# ─── Messages Service ──────────────────────────────────────────
MESSAGES_SERVICE_PORT=8003
SCYLLA_NODES=localhost:9042
SCYLLA_KEYSPACE=discord_messages

# ─── Media Service ─────────────────────────────────────────────
MEDIA_SERVICE_PORT=8005
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=discord-media
CDN_BASE_URL=http://localhost:9000/discord-media

# ─── Voice Service ────────────────────────────────────────────
VOICE_SERVICE_PORT=8004
VOICE_SIGNALING_PORT=8005
DOMAIN=localhost
# WebRTC NAT traversal
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-user
TURN_PASSWORD=your-turn-password
HEARTBEAT_INTERVAL_MS=41250

# ─── Search Service ────────────────────────────────────────────
SEARCH_SERVICE_PORT=8006
ELASTICSEARCH_URL=http://localhost:9200

# ─── Notification Service ──────────────────────────────────────
NOTIFICATIONS_SERVICE_PORT=8007
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=discord-consumers

# ─── External Services ─────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@discord.dev

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ─── App Config ────────────────────────────────────────────────
RUST_LOG=debug
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# ─── Database URLs (per service) ───────────────────────────────
AUTH_DATABASE_URL=postgres://discord_app:app_password@localhost:5432/discord_auth
GUILDS_DATABASE_URL=postgres://discord_app:app_password@localhost:5432/discord_guilds
NOTIFS_DATABASE_URL=postgres://discord_app:app_password@localhost:5432/discord_notifications
SCYLLA_KEYSPACE=discord

# ─── Frontend (Next.js) — clients/web/.env.local ───────────────
# Copy các dòng này vào clients/web/.env.local

# Backend API (API Gateway)
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket Gateway
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Voice WebRTC
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8004
NEXT_PUBLIC_TURN_URL=turn:localhost:3478

# GIF Picker — Lấy key miễn phí tại: https://developers.giphy.com → Create App → API
NEXT_PUBLIC_GIPHY_API_KEY=your_giphy_api_key_here

# CDN / Media
NEXT_PUBLIC_CDN_URL=http://localhost:9000/discord-media
