# ─── Auth Service ──────────────────────────────────────────────
AUTH_SERVICE_PORT=8001
DATABASE_URL=postgres://postgres:password@localhost:5432/discord_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Gateway Service ───────────────────────────────────────────
GATEWAY_PORT=8000
GATEWAY_REDIS_URL=redis://localhost:6379

# ─── Guilds Service ────────────────────────────────────────────
GUILDS_SERVICE_PORT=8002
GUILDS_DATABASE_URL=postgres://postgres:password@localhost:5432/discord_dev

# ─── Messages Service ──────────────────────────────────────────
MESSAGES_SERVICE_PORT=8003
SCYLLA_NODES=localhost:9042
SCYLLA_KEYSPACE=discord_messages

# ─── Media Service ─────────────────────────────────────────────
MEDIA_SERVICE_PORT=8004
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=discord-media
CDN_BASE_URL=http://localhost:9000/discord-media

# ─── Search Service ────────────────────────────────────────────
SEARCH_SERVICE_PORT=8005
ELASTICSEARCH_URL=http://localhost:9200

# ─── Notification Service ──────────────────────────────────────
NOTIFICATIONS_SERVICE_PORT=8006
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=discord-consumers

# ─── External Services ─────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@discord.dev

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ─── App Config ────────────────────────────────────────────────
RUST_LOG=debug
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:1420
